# 复制本文件为 .env，填入真实值后即可（.env 已被 .gitignore 排除，不会提交）
# 优先级：系统环境变量 > .env；数据库配置没有内置兜底值

# ── 数据库（必须显式配置；代码不再内置任何内网地址或凭据）──
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── 抓取工具数据库（仅在需要运行抓取/对账工具时显式配置）──
FETCH_DB_HOST=
FETCH_DB_PORT=3306
FETCH_DB_USER=
FETCH_DB_PASSWORD=
FETCH_DB_NAME=

# ── DeepSeek API ──
DEEPSEEK_API_KEY=
DEEPSEEK_SELECTION_API_KEY=
# 通告发放「一键 AI 美化」专用 Key；为空时后端回退使用 DEEPSEEK_API_KEY
ANNOUNCE_AI_API_KEY=
# 内容工坊 AI（服务端专用；留空时沿用 DEEPSEEK_API_KEY；模型名按 DeepSeek API 使用 deepseek-flash）
CONTENT_STUDIO_API_KEY=
CONTENT_STUDIO_MODEL=deepseek-flash

# ── 抓取请求节奏（合规限速，不用于绕过平台风控）──
# OCR_ENABLE_MKLDNN=0（默认）可避免部分 Paddle PIR/oneDNN 版本兼容性异常；
# 仅在已验证当前运行时兼容时设置为 1。
OCR_ENABLE_MKLDNN=0
# OCR_RETRY_LOW_CONFIDENCE=0（默认）只对完全无文字结果做增强重试；
# 设置为 1 可提高低置信度图片的召回率，但会增加这类图片的识别耗时。
OCR_RETRY_LOW_CONFIDENCE=0
# 每次平台接口请求之间的最小间隔（秒）；默认 2.5
CRAWLER_MIN_INTERVAL=2.5
# 在最小间隔上增加的随机抖动上限（秒）；默认 0.35
CRAWLER_JITTER=0.35
# 收到 429/403/5xx 且服务端未给 Retry-After 时的最长冷却（秒）；默认 300
CRAWLER_COOLDOWN_CAP=300
